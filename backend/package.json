{
  "name": "whatsapp-crm-backend",
  "version": "1.0.0",
  "description": "WhatsApp Lead Management CRM - Backend",
  "main": "dist/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
