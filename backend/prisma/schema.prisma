generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  IN_PROGRESS
  HOT
  CLOSED
  LOST
  IRRELEVANT
}

enum Priority {
  Low
  Med
  High
}

enum MessageType {
  text
  image
  document
}

enum LineProvider {
  GREEN_API
  META
}

// Which channel a conversation lives on. WhatsApp leads keep their phone identity;
// webchat/IG/Messenger contacts have no phone and are keyed by (channel, externalId).
enum LeadChannel {
  WHATSAPP
  WEBCHAT
  INSTAGRAM
  MESSENGER
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  sent
  delivered
  read
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
}

enum TenantPlan {
  TRIAL
  BASIC
  PRO
}

// ─── Multi-Tenant Models ──────────────────────────────────────────────────────

model Tenant {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  plan         TenantPlan @default(TRIAL)
  active       Boolean    @default(true)
  // Green API credentials (per tenant). A Green API instance belongs to exactly one
  // tenant, so the instance id is unique (NULLs are allowed for unconfigured tenants).
  greenApiInstanceId String?  @unique
  greenApiToken      String?
  greenApiWebhookUrl String?
  // Shared secret embedded in the webhook URL (?token=…). When set, inbound
  // webhooks must present it — blocks payload forgery by anyone who knows the instanceId.
  webhookSecret      String?
  // Lead auto-assignment: 'manual' (default) or 'round_robin' across active agents.
  assignmentMode     String  @default("manual")
  assignmentPointer  Int     @default(0)
  // Auto-reply config: { greeting, offHours, away } — see lib/autoReply.ts.
  autoReplies        Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  users        User[]
  leads        Lead[]
  lines        Line[]
  projects     Project[]
  templates    Template[]
  automations  AutomationWebhook[]
  jobs         Job[]
  // Real-estate domain (added in phase-2 integration)
  deals        Deal[]
  properties   Property[]
  reProjects   REProject[]
  listings     Listing[]
  reClients    REClient[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  email        String?
  // 2FA per user (optional)
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  // Google Calendar (one-way sync, per user)
  googleRefreshToken String?
  googleEmail        String?
  // Google Sign-In: the linked Google account's stable id (sub). Set via explicit
  // account linking in Settings; lets the user log in with "Sign in with Google".
  googleId           String? @unique
  googleLoginEmail   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities   Activity[]
  resetTokens  PasswordResetToken[]
  linesOwned   Line[]     @relation("LineOwner")

  @@unique([tenantId, username])
}

// ─── CRM Models (all scoped to tenant) ───────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#3B82F6")
  active      Boolean  @default(true)
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

model Lead {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Which WhatsApp line (number) this conversation belongs to. Nullable during the
  // multi-line rollout; backfilled to each tenant's main line by migration.
  lineId        String?
  line          Line?      @relation(fields: [lineId], references: [id], onDelete: SetNull)
  name          String
  email         String?
  company       String?
  // Nullable since multi-channel: webchat/IG/Messenger contacts have no phone.
  // WhatsApp leads always have one (all WhatsApp code paths pass a normalized phone).
  phone         String?
  // Channel identity for non-phone channels: externalId is the channel-scoped id
  // (webchat visitorId, Messenger PSID, Instagram IGSID).
  channel       LeadChannel @default(WHATSAPP)
  externalId    String?
  status        LeadStatus @default(NEW)
  priority      Priority   @default(Med)
  lastMessageAt DateTime?
  internalNotes String?
  assignedTo    String?
  tags          String[]   @default([])
  meetingDate   DateTime?
  meetingNotes  String?
  // Last time an automated reply was sent to this lead (auto-reply anti-loop throttle).
  lastAutoReplyAt DateTime?
  // Google Calendar event mirror (one-way sync)
  googleEventId       String?
  googleCalendarUserId String?
  messages      Message[]
  activities    Activity[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // NOTE: Postgres composite unique indexes skip rows where any column is NULL, so
  // multiple NULL-phone leads coexist and this constraint only binds WhatsApp leads.
  @@unique([tenantId, phone])
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, meetingDate])
  @@index([projectId])
  @@index([lineId])
}

// A deferred unit of work (scheduled message, campaign step, CSAT survey, ...).
// Polled by lib/jobs.ts every few seconds — fits the single-instance deployment;
// scaling to replicas later means externalizing this to a real queue.
model Job {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   // handler key, e.g. 'send_message'
  runAt     DateTime // don't pick up before this time
  payload   Json?
  status    String   @default("pending") // pending | running | done | failed | cancelled
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([tenantId])
}

// A WhatsApp line = one phone number = one set of provider credentials. A tenant may
// own several. Provider-neutral: today Green API, tomorrow Meta, without a rewrite.
model Line {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String       // display label, e.g. "יוסי — מכירות"
  provider           LineProvider @default(GREEN_API)
  phoneNumber        String?      // the actual WhatsApp number (display)
  active             Boolean      @default(true)
  // Line-per-agent: the agent who owns this line (null = shared/company line).
  assignedUserId     String?
  assignedUser       User?        @relation("LineOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)
  // Green API credentials
  greenApiInstanceId String?      @unique
  greenApiToken      String?
  // Meta Cloud API credentials (future)
  metaPhoneNumberId  String?      @unique
  metaAccessToken    String?
  metaWabaId         String?
  // Shared
  webhookSecret      String?
  // Per-line anti-ban daily counter
  dailyCount         Int          @default(0)
  dailyCountDate     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  leads              Lead[]

  @@index([tenantId])
  @@index([assignedUserId])
}

model Message {
  id         String           @id @default(cuid())
  tenantId   String
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content    String
  type       MessageType      @default(text)
  mediaUrl   String?          // Green API urlFile / downloadUrl for image & document messages
  fileName   String?          // original filename (documents) shown as the download label
  direction  MessageDirection
  status     MessageStatus    @default(sent)
  externalId String?          // Green API idMessage — used to apply delivered/read status updates
  timestamp  DateTime         @default(now())

  @@index([leadId, timestamp])
  @@index([externalId])
  @@index([tenantId, externalId])
}

model Template {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  body     String
  category String

  @@index([tenantId])
}

model Activity {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor     String   @default("מערכת")
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([userId])
}

model AutomationWebhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  url       String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Real-Estate Domain Models (phase-2 integration, all tenant-scoped) ───────

model Deal {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectName    String
  blockParcel    String?
  city           String?
  status         String   @default("Scouting") // Scouting|Underwriting|Active|Closed|Rejected
  gdv            Float    @default(0)           // Estimated Sales Value (GDV)
  expectedMargin Float    @default(0)           // Expected developer margin %
  riskAlert      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model Property {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  addressCity        String?
  priceRequested     Float    @default(0)
  status             String   @default("Active") // Active|Expired|Pending|Cancelled
  exclusivityEndDate String?                      // YYYY-MM-DD
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
}

model REProject {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectName      String
  developer        String?
  city             String?
  neighborhood     String?
  address          String?
  status           String   @default("under_construction")
  expectedDelivery String?
  deliveryEarliest String?
  deliveryLatest   String?
  totalUnits       Int      @default(0)
  availableUnits   Int?     // null => "לא ידוע"
  unitTypes        Int[]    @default([])
  priceMin         Float?
  priceMax         Float?
  amenities        String[] @default([])
  urbanRenewal     Boolean  @default(false)
  urbanRenewalType String?
  salesOffice      String?
  source           String   @default("CRM (ידני)")
  sourceTier       Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

model Listing {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  type         String   @default("דירה")
  city         String?
  neighborhood String?
  street       String?
  rooms        Int      @default(0)
  floor        Int      @default(0)
  totalFloors  Int      @default(0) // total floors in the building ("קומה X מתוך Y")
  sizeSqm      Int      @default(0)
  price        Float    @default(0)
  parking      Boolean  @default(false)
  elevator     Boolean  @default(false)
  balcony      Boolean  @default(false)
  renovated    Boolean  @default(false)
  entry        String   @default("מיידי")
  status       String   @default("פעיל") // פעיל|בהמתנה|נמכר
  agent        String?
  listedBy     String   @default("") // פרטי | בתיווך
  source       String   @default("CRM (ידני)")
  sourceUrl    String   @default("") // direct link to the original ad (Yad2/Madlan)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model REClient {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  city       String?
  rooms      Int      @default(0)
  budgetMax  Float    @default(0)
  deliveryBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}
